{
  "name": "bookhive-benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "Public benchmark harness for @civitas-cerebrum/achilles, run against the BookHive docker target.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bookhive-benchmark": "./analyzer/src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sh": "bats analyzer/tests/sh",
    "typecheck": "tsc --noEmit",
    "analyze": "tsx analyzer/src/cli.ts"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "bats": "^1.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
